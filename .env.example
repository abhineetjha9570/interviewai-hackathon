# Environment variables for InterviewAI
# Database: SQLite is default for zero-friction local development.
# For PostgreSQL in production, change provider to 'postgresql' and set:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/interviewai?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="replace_with_a_secure_random_secret"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External AI API Keys (fallback local brain runs if not provided)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
